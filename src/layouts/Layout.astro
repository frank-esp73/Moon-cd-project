	@keyframes twinkle {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	header {
		padding: 2rem clamp(1.5rem, 6vw, 4rem) 0.5rem;
	}

	.brand {
		font-size: 1.1rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--fg);
		text-decoration: none;
	}

	.brand .amp {
		color: var(--muted);
	}

	main {
		flex: 1;
		padding: 1rem clamp(1.5rem, 6vw, 4rem) 3rem;
		max-width: 46rem;
	}

	a {
		color: var(--accent);
