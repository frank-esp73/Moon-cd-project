		--bg: #05050c;
		--bg-alt: #0d0d1a;
		--fg: #e8e8f0;
		--muted: #8b8ba3;
		--accent: #cfd8ff;
		font-family: 'Georgia', 'Times New Roman', serif;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

