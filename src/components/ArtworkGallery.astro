---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/artwork/*.png', {
	eager: true,
});

const CAPTIONS: Record<string, string> = {
	'01-coverbooklet-cover': 'Portada',
	'02-coverbooklet-tracklist': 'Lista de canciones',
	'03-pag1-lyrics': 'Tonight Tonight — letra',
	'04-pag1-art': 'Ilustración',
	'05-pag2ext-left': 'Dedicatoria',
	'06-pag2ext-right': 'Moon — letra',
	'07-pag2int-left': 'Interior del folleto',
	'08-pag2int-right': 'Interior del folleto',
	'09-page3ext-left': 'Interior del folleto',
	'10-page3ext-right': 'Interior del folleto',
	'11-page3int-left': 'Just Like Heaven — letra',
	'12-page3int-right': 'Photograph',
	'13-pag4ext-left': 'Interior del folleto',
	'14-pag4ext-right': 'Interior del folleto',
	'15-page4int-left': 'Interior del folleto',
	'16-page4int-right': 'Interior del folleto',
	'17-back-tray': 'Contraportada',
	'18-cd-art1': 'Arte del disco',
	'19-cd2': 'Arte del disco (alterno)',
};

const artwork = Object.entries(images)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod]) => {
		const stem = path.split('/').pop()!.replace(/\.png$/, '');
		return {
			image: mod.default,
			caption: CAPTIONS[stem] ?? stem,
		};
	});
---

<section class="gallery" aria-label="Galería de arte">
	<h2>Galería de Arte</h2>
	<div class="carousel">
		{
			artwork.map((item, i) => (
				<button type="button" class="thumb" data-index={i} aria-label={`Ver ${item.caption}`}>
					<Image src={item.image} alt={item.caption} width={320} />
				</button>
			))
		}
	</div>

	<dialog class="lightbox" id="artwork-lightbox">
		<button type="button" class="lightbox__close" aria-label="Cerrar">&times;</button>
		<button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Anterior">&#8249;</button>
		<button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Siguiente">&#8250;</button>
		<div class="lightbox__track">
			{
				artwork.map((item) => (
					<figure class="lightbox__slide">
						<Image src={item.image} alt={item.caption} width={1200} />
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</dialog>
</section>

<script>
	const dialog = document.getElementById('artwork-lightbox') as HTMLDialogElement | null;
	if (dialog) {
		const track = dialog.querySelector('.lightbox__track') as HTMLElement;
		const slides = Array.from(track.children) as HTMLElement[];
		const thumbs = Array.from(document.querySelectorAll<HTMLElement>('.thumb'));

		function openAt(index: number) {
			dialog!.showModal();
			slides[index]?.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
		}

		thumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				openAt(Number(thumb.dataset.index));
			});
		});

		dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog!.close());

		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog!.close();
		});

		function currentIndex() {
			const trackRect = track.getBoundingClientRect();
			const center = trackRect.left + trackRect.width / 2;
			let closest = 0;
			let closestDist = Infinity;
			slides.forEach((slide, i) => {
				const r = slide.getBoundingClientRect();
				const dist = Math.abs(r.left + r.width / 2 - center);
				if (dist < closestDist) {
					closestDist = dist;
					closest = i;
				}
			});
			return closest;
		}

		function go(delta: number) {
			const next = Math.min(slides.length - 1, Math.max(0, currentIndex() + delta));
			slides[next]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
		}

		dialog.querySelector('.lightbox__nav--prev')?.addEventListener('click', () => go(-1));
		dialog.querySelector('.lightbox__nav--next')?.addEventListener('click', () => go(1));

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') go(-1);
			if (e.key === 'ArrowRight') go(1);
		});
	}
</script>

<style>
	.gallery {
		margin: 3rem 0;
	}

	h2 {
		font-size: clamp(1.4rem, 4vw, 1.9rem);
		margin: 0 0 1rem;
		letter-spacing: 0.02em;
	}

	.carousel {
		display: flex;
		gap: 0.75rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.75rem;
		margin: 0 -0.25rem;
		scrollbar-color: var(--muted) transparent;
	}

	.thumb {
		flex: 0 0 auto;
		scroll-snap-align: start;
		border: none;
		background: none;
		padding: 0;
		margin: 0 0.25rem;
		cursor: pointer;
		border-radius: 0.4rem;
		overflow: hidden;
		box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.5);
		line-height: 0;
		transition: transform 0.15s ease;
	}

	.thumb:hover,
	.thumb:focus-visible {
		transform: translateY(-3px);
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.thumb :global(img) {
		display: block;
		height: 8.5rem;
		width: auto;
	}

	.lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: none;
		background: rgba(5, 5, 12, 0.97);
		color: var(--fg);
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
	}

	.lightbox__track {
		display: flex;
		height: 100%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
	}

	.lightbox__slide {
		flex: 0 0 100%;
		scroll-snap-align: center;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 3rem 4rem;
	}

	.lightbox__slide :global(img) {
		max-width: 100%;
		max-height: 78vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0.25rem;
		box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.6);
	}

	.lightbox__slide figcaption {
		color: var(--muted);
		font-style: italic;
	}

	.lightbox__close,
	.lightbox__nav {
		position: fixed;
		z-index: 2;
		background: rgba(255, 255, 255, 0.08);
		color: var(--fg);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 50%;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
	}

	.lightbox__close:hover,
	.lightbox__nav:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	.lightbox__close {
		top: 1.25rem;
		right: 1.25rem;
	}

	.lightbox__nav--prev {
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox__nav--next {
		right: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	@media (max-width: 30rem) {
		.lightbox__slide {
			padding: 2rem 1rem;
		}
	}
</style>
