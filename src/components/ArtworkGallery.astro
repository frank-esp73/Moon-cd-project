---
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/artwork/*.png', {
	eager: true,
});

const CAPTIONS: Record<string, string> = {
	'01-coverbooklet': 'Portada y lista de canciones',
	'02-pag1': 'Tonight Tonight',
	'03-pag2ext': 'Dedicatoria y Moon',
	'04-pag2int': 'Interior del folleto',
	'05-page3ext': 'Interior del folleto',
	'06-page3int': 'Just Like Heaven y Photograph',
	'07-pag4ext': 'Interior del folleto',
	'08-page4int': 'Interior del folleto',
	'09-back-tray': 'Contraportada',
	'10-cd-art1': 'Arte del disco',
	'11-cd2': 'Arte del disco (alterno)',
};

const artwork = Object.entries(images)
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([path, mod]) => {
		const stem = path.split('/').pop()!.replace(/\.png$/, '');
		return {
			image: mod.default,
			caption: CAPTIONS[stem] ?? stem,
		};
	});
---

<section class="gallery" aria-label="Galería de arte">
	<h2>Galería de Arte</h2>

	<div class="viewer">
		<button type="button" class="viewer__nav viewer__nav--prev" aria-label="Anterior">&#8249;</button>
		<div class="viewer__track" id="gallery-track">
			{
				artwork.map((item, i) => (
					<button type="button" class="viewer__slide" data-index={i} aria-label={`Ampliar ${item.caption}`}>
						<Image src={item.image} alt={item.caption} width={1000} />
					</button>
				))
			}
		</div>
		<button type="button" class="viewer__nav viewer__nav--next" aria-label="Siguiente">&#8250;</button>
	</div>
	<p class="viewer__caption" id="gallery-caption">
		<span id="gallery-count">1 / {artwork.length}</span> — <span id="gallery-label">{artwork[0].caption}</span>
	</p>

	<dialog class="lightbox" id="artwork-lightbox">
		<button type="button" class="lightbox__close" aria-label="Cerrar">&times;</button>
		<button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Anterior">&#8249;</button>
		<button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Siguiente">&#8250;</button>
		<div class="lightbox__track">
			{
				artwork.map((item) => (
					<figure class="lightbox__slide">
						<Image src={item.image} alt={item.caption} width={1800} />
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</dialog>
</section>

<script>
	function nearestIndex(track: HTMLElement, slides: HTMLElement[]) {
		const trackRect = track.getBoundingClientRect();
		const center = trackRect.left + trackRect.width / 2;
		let closest = 0;
		let closestDist = Infinity;
		slides.forEach((slide, i) => {
			const r = slide.getBoundingClientRect();
			const dist = Math.abs(r.left + r.width / 2 - center);
			if (dist < closestDist) {
				closestDist = dist;
				closest = i;
			}
		});
		return closest;
	}

	// Main single-image viewer
	const viewerTrack = document.getElementById('gallery-track');
	const captionEl = document.getElementById('gallery-label');
	const countEl = document.getElementById('gallery-count');
	if (viewerTrack) {
		const slides = Array.from(viewerTrack.children) as HTMLElement[];
		const captions = slides.map((s) => s.querySelector('img')?.alt ?? '');
		const prevBtn = document.querySelector('.viewer__nav--prev') as HTMLElement;
		const nextBtn = document.querySelector('.viewer__nav--next') as HTMLElement;

		function updateCaption() {
			const i = nearestIndex(viewerTrack!, slides);
			if (captionEl) captionEl.textContent = captions[i];
			if (countEl) countEl.textContent = `${i + 1} / ${slides.length}`;
		}

		function go(delta: number) {
			const i = Math.min(slides.length - 1, Math.max(0, nearestIndex(viewerTrack!, slides) + delta));
			slides[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
		}

		prevBtn?.addEventListener('click', () => go(-1));
		nextBtn?.addEventListener('click', () => go(1));

		let scrollTimer: ReturnType<typeof setTimeout>;
		viewerTrack.addEventListener('scroll', () => {
			clearTimeout(scrollTimer);
			scrollTimer = setTimeout(updateCaption, 100);
		});

		// Clicking the visible slide opens the lightbox at that index
		const dialog = document.getElementById('artwork-lightbox') as HTMLDialogElement | null;
		slides.forEach((slide) => {
			slide.addEventListener('click', () => {
				const i = Number(slide.dataset.index);
				openLightbox(i);
			});
		});

		function openLightbox(index: number) {
			if (!dialog) return;
			const lightboxTrack = dialog.querySelector('.lightbox__track') as HTMLElement;
			const lightboxSlides = Array.from(lightboxTrack.children) as HTMLElement[];
			dialog.showModal();
			lightboxSlides[index]?.scrollIntoView({ behavior: 'auto', block: 'nearest', inline: 'center' });
		}
	}

	// Fullscreen lightbox
	const dialog = document.getElementById('artwork-lightbox') as HTMLDialogElement | null;
	if (dialog) {
		const track = dialog.querySelector('.lightbox__track') as HTMLElement;
		const slides = Array.from(track.children) as HTMLElement[];

		dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog!.close());

		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog!.close();
		});

		function go(delta: number) {
			const i = Math.min(slides.length - 1, Math.max(0, nearestIndex(track, slides) + delta));
			slides[i]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
		}

		dialog.querySelector('.lightbox__nav--prev')?.addEventListener('click', () => go(-1));
		dialog.querySelector('.lightbox__nav--next')?.addEventListener('click', () => go(1));

		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') go(-1);
			if (e.key === 'ArrowRight') go(1);
		});
	}
</script>

<style>
	.gallery {
		margin: 3rem 0;
	}

	h2 {
		font-size: clamp(1.4rem, 4vw, 1.9rem);
		margin: 0 0 1rem;
		letter-spacing: 0.02em;
	}

	.viewer {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.viewer__track {
		flex: 1;
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		border-radius: 0.5rem;
		scrollbar-width: none;
	}

	.viewer__track::-webkit-scrollbar {
		display: none;
	}

	.viewer__slide {
		flex: 0 0 100%;
		scroll-snap-align: center;
		border: none;
		background: rgba(255, 255, 255, 0.02);
		padding: 0;
		margin: 0;
		cursor: zoom-in;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.5rem;
		overflow: hidden;
		box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.55);
	}

	.viewer__slide :global(img) {
		display: block;
		width: 100%;
		height: auto;
		max-height: 26rem;
		object-fit: contain;
	}

	.viewer__nav {
		flex-shrink: 0;
		background: rgba(255, 255, 255, 0.08);
		color: var(--fg);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 50%;
		width: 2.5rem;
		height: 2.5rem;
		font-size: 1.3rem;
		line-height: 1;
		cursor: pointer;
	}

	.viewer__nav:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	.viewer__caption {
		margin: 0.75rem 0 0;
		color: var(--muted);
		font-style: italic;
		text-align: center;
		font-size: 0.9rem;
	}

	.lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: none;
		background: rgba(5, 5, 12, 0.97);
		color: var(--fg);
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
	}

	.lightbox__track {
		display: flex;
		height: 100%;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
	}

	.lightbox__slide {
		flex: 0 0 100%;
		scroll-snap-align: center;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 3rem 4rem;
	}

	.lightbox__slide :global(img) {
		max-width: 100%;
		max-height: 78vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 0.25rem;
		box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.6);
	}

	.lightbox__slide figcaption {
		color: var(--muted);
		font-style: italic;
	}

	.lightbox__close,
	.lightbox__nav {
		position: fixed;
		z-index: 2;
		background: rgba(255, 255, 255, 0.08);
		color: var(--fg);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 50%;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
	}

	.lightbox__close:hover,
	.lightbox__nav:hover {
		background: rgba(255, 255, 255, 0.16);
	}

	.lightbox__close {
		top: 1.25rem;
		right: 1.25rem;
	}

	.lightbox__nav--prev {
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox__nav--next {
		right: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	@media (max-width: 30rem) {
		.viewer__slide :global(img) {
			max-height: 16rem;
		}

		.lightbox__slide {
			padding: 2rem 1rem;
		}
	}
</style>
