---
interface Props {
	size?: string;
	class?: string;
}

const { size = '14rem', class: className = '' } = Astro.props;
---

<div class:list={['moon', className]} style={`--size: ${size}`}>
	<div class="moon__glow"></div>
	<div class="moon__disc"></div>
</div>

<style>
	.moon {
		position: relative;
		width: var(--size);
		height: var(--size);
		flex-shrink: 0;
	}

	.moon__glow {
		position: absolute;
		inset: -18%;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(210, 220, 255, 0.35) 0%,
			rgba(210, 220, 255, 0.12) 40%,
			transparent 70%
		);
		filter: blur(6px);
	}

	.moon__disc {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background:
			/* maria (dark plains) */
			radial-gradient(ellipse 30% 22% at 38% 28%, rgba(60, 62, 78, 0.55), transparent 70%),
			radial-gradient(ellipse 22% 30% at 62% 24%, rgba(60, 62, 78, 0.5), transparent 70%),
			radial-gradient(ellipse 26% 20% at 58% 46%, rgba(55, 58, 74, 0.5), transparent 70%),
			radial-gradient(ellipse 18% 24% at 30% 58%, rgba(58, 60, 76, 0.45), transparent 70%),
			radial-gradient(ellipse 20% 16% at 68% 66%, rgba(55, 58, 74, 0.4), transparent 70%),
			/* crater rays */
				radial-gradient(circle 5% at 52% 78%, rgba(255, 255, 255, 0.5), transparent 60%),
			radial-gradient(circle 3% at 25% 40%, rgba(20, 20, 30, 0.4), transparent 70%),
			radial-gradient(circle 2.5% at 70% 35%, rgba(20, 20, 30, 0.35), transparent 70%),
			radial-gradient(circle 2% at 45% 62%, rgba(20, 20, 30, 0.3), transparent 70%),
			/* overall sphere shading, lit from upper-left */
				radial-gradient(circle at 35% 32%, #f4f2f0 0%, #d8d6d8 30%, #a9a8b2 62%, #6b6a78 88%, #4a4956 100%);
		box-shadow:
			inset -1.2rem -1rem 2.5rem rgba(0, 0, 0, 0.55),
			inset 0.4rem 0.4rem 1.5rem rgba(255, 255, 255, 0.25);
	}
</style>
