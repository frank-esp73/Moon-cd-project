---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import cover from '../../assets/cover.png';

export async function getStaticPaths() {
	const tracks = await getCollection('tracks');
	return tracks.map((track) => ({
		params: { id: track.id },
		props: { track },
	}));
}

const { track } = Astro.props;
const { Content } = await render(track);
const base = import.meta.env.BASE_URL;
---

<Layout title={`${track.data.title} — Moon`}>
	<a class="back" href={base}>&larr; Moon &amp; Frank and Agape</a>
	<div class="heading">
		<Image src={cover} alt="" width={112} class="cover-thumb" />
		<h1>
			<span class="num">{String(track.data.number).padStart(2, '0')}</span>
			{track.data.title}
		</h1>
	</div>
	<div class="lyrics">
		<Content />
	</div>
</Layout>

<style>
	.back {
		display: inline-block;
		margin-bottom: 2rem;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.9rem;
	}

	.back:hover {
		color: var(--accent);
	}

	.heading {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin: 0 0 2rem;
	}

	.heading :global(.cover-thumb) {
		width: 3.5rem;
		height: 3.5rem;
		object-fit: cover;
		border-radius: 0.35rem;
		box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.5);
		flex-shrink: 0;
	}

	h1 {
		font-size: clamp(1.75rem, 5vw, 2.75rem);
		margin: 0;
	}

	.num {
		color: var(--muted);
		margin-right: 0.75rem;
		font-variant-numeric: tabular-nums;
	}

	.lyrics {
		font-size: 1.1rem;
		line-height: 1.9;
		white-space: pre-line;
	}

	.lyrics :global(p) {
		margin: 0 0 1.4em;
	}

	.lyrics :global(details.meaning) {
		white-space: normal;
		margin: 0 0 1.6em;
		border: 1px solid rgba(232, 232, 240, 0.15);
		border-radius: 0.6rem;
		background: rgba(255, 255, 255, 0.03);
		padding: 0 1.25rem;
	}

	.lyrics :global(details.meaning[open]) {
		padding-bottom: 0.25rem;
	}

	.lyrics :global(details.meaning summary) {
		cursor: pointer;
		padding: 0.9rem 0;
		color: var(--accent);
		font-style: italic;
		font-size: 0.95rem;
		list-style: none;
	}

	.lyrics :global(details.meaning summary::-webkit-details-marker) {
		display: none;
	}

	.lyrics :global(details.meaning summary::before) {
		content: '▸ ';
		display: inline-block;
		transition: transform 0.15s ease;
	}

	.lyrics :global(details.meaning[open] summary::before) {
		transform: rotate(90deg);
	}

	.lyrics :global(details.meaning p) {
		margin: 0 0 1.25rem;
		line-height: 1.75;
		font-size: 1rem;
		font-style: italic;
		color: var(--muted);
	}
</style>
