---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.number - b.data.number);
const base = import.meta.env.BASE_URL;
---

<Layout title="Moon — Frank and Agape">
	<h1>Moon</h1>
	<p class="tagline">An album by Frank and Agape.</p>

	<ol class="tracklist">
		{
			tracks.map((track) => (
				<li>
					<a href={`${base}tracks/${track.id}/`}>
						<span class="num">{String(track.data.number).padStart(2, '0')}</span>
						<span class="title">{track.data.title}</span>
					</a>
				</li>
			))
		}
	</ol>
</Layout>

<style>
	h1 {
		font-size: clamp(2.5rem, 8vw, 4rem);
		margin: 0 0 0.25rem;
		letter-spacing: 0.05em;
	}

	.tagline {
		color: var(--muted);
		margin: 0 0 2.5rem;
	}

	.tracklist {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(232, 232, 240, 0.12);
	}

	.tracklist li {
		border-bottom: 1px solid rgba(232, 232, 240, 0.12);
	}

	.tracklist a {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding: 0.9rem 0.25rem;
		text-decoration: none;
		color: var(--fg);
		transition: color 0.15s ease;
	}

	.tracklist a:hover {
		color: var(--accent);
	}

	.num {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		width: 1.5rem;
	}

	.title {
		font-size: 1.05rem;
	}
</style>
