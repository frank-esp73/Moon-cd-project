---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import cover from '../assets/cover.png';
import ArtworkGallery from '../components/ArtworkGallery.astro';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.number - b.data.number);
const trackEntries = await Promise.all(
	tracks.map(async (track) => ({ track, Content: (await render(track)).Content }))
);
---

<Layout title="Moon & Frank and Agape">
	<div class="hero">
		<Image src={cover} alt="Moon & Frank and Agape album cover" width={640} class="cover" />
		<div class="hero__text">
			<h1>Moon <span class="amp">&amp;</span> Frank and Agape</h1>
			<p class="tagline">Lo Que Dicen Estas Letras</p>
		</div>
	</div>

	<ol class="tracklist">
		{
			trackEntries.map(({ track, Content }) => (
				<li>
					<details class="track">
						<summary>
							<span class="num">{String(track.data.number).padStart(2, '0')}</span>
							<span class="title">{track.data.title}</span>
						</summary>
						<div class="lyrics">
							<Content />
						</div>
					</details>
				</li>
			))
		}
	</ol>

	<ArtworkGallery />
</Layout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		margin: 1rem 0 3rem;
	}

	.hero :global(.cover) {
		width: clamp(9rem, 28vw, 16rem);
		height: auto;
		border-radius: 0.5rem;
		box-shadow:
			0 0 2.5rem rgba(180, 190, 255, 0.18),
			0 1rem 2.5rem rgba(0, 0, 0, 0.6);
		flex-shrink: 0;
	}

	h1 {
		font-size: clamp(1.9rem, 6vw, 3.25rem);
		margin: 0 0 0.35rem;
		letter-spacing: 0.02em;
		line-height: 1.1;
	}

	h1 .amp {
		color: var(--muted);
		font-style: italic;
	}

	.tagline {
		color: var(--muted);
		margin: 0;
	}

	.tracklist {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(232, 232, 240, 0.12);
	}

	.tracklist li {
		border-bottom: 1px solid rgba(232, 232, 240, 0.12);
	}

	.track summary {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding: 0.9rem 0.25rem;
		cursor: pointer;
		color: var(--fg);
		list-style: none;
		transition: color 0.15s ease;
	}

	.track summary::-webkit-details-marker {
		display: none;
	}

	.track summary::before {
		content: '▸';
		color: var(--muted);
		font-size: 0.85em;
		transition: transform 0.15s ease;
	}

	.track[open] summary::before {
		transform: rotate(90deg);
	}

	.track summary:hover {
		color: var(--accent);
	}

	.num {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		width: 1.5rem;
	}

	.title {
		font-size: 1.05rem;
	}

	.lyrics {
		padding: 0 0.25rem 1.85rem 2.75rem;
		font-size: 1.05rem;
		line-height: 1.85;
		white-space: pre-line;
	}

	.lyrics :global(p) {
		margin: 0 0 1.4em;
	}

	.lyrics :global(details.meaning) {
		white-space: normal;
		margin: 0 0 1.6em;
		border: 1px solid rgba(207, 216, 255, 0.28);
		border-left: 3px solid var(--accent);
		border-radius: 0.5rem;
		background: rgba(207, 216, 255, 0.08);
		padding: 0 1.25rem;
	}

	.lyrics :global(details.meaning[open]) {
		padding-bottom: 0.25rem;
	}

	.lyrics :global(details.meaning summary) {
		display: block;
		cursor: pointer;
		padding: 0.9rem 0;
		color: var(--accent);
		font-style: italic;
		font-size: 0.95rem;
		list-style: none;
	}

	.lyrics :global(details.meaning summary::-webkit-details-marker) {
		display: none;
	}

	.lyrics :global(details.meaning summary::before) {
		content: '▸ ';
		display: inline-block;
		transition: transform 0.15s ease;
	}

	.lyrics :global(details.meaning[open] summary::before) {
		transform: rotate(90deg);
	}

	.lyrics :global(details.meaning p) {
		margin: 0 0 1.25rem;
		line-height: 1.75;
		font-size: 1rem;
		font-style: italic;
		color: var(--fg);
	}

	.lyrics :global(details.meaning p:last-child) {
		margin-bottom: 1.25rem;
	}

	@media (max-width: 30rem) {
		.lyrics {
			padding-left: 1.5rem;
		}
	}

	@media (max-width: 30rem) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
