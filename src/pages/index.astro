---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import cover from '../assets/cover.png';

const tracks = (await getCollection('tracks')).sort((a, b) => a.data.number - b.data.number);
const base = import.meta.env.BASE_URL;
---

<Layout title="Moon & Frank and Agape">
	<div class="hero">
		<Image src={cover} alt="Moon & Frank and Agape album cover" width={640} class="cover" />
		<div class="hero__text">
			<h1>Moon <span class="amp">&amp;</span> Frank and Agape</h1>
			<p class="tagline">Lo Que Dicen Estas Letras</p>
		</div>
	</div>

	<ol class="tracklist">
		{
			tracks.map((track) => (
				<li>
					<a href={`${base}tracks/${track.id}/`}>
						<span class="num">{String(track.data.number).padStart(2, '0')}</span>
						<span class="title">{track.data.title}</span>
					</a>
				</li>
			))
		}
	</ol>
</Layout>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: clamp(1.25rem, 4vw, 2.5rem);
		margin: 1rem 0 3rem;
	}

	.hero :global(.cover) {
		width: clamp(9rem, 28vw, 16rem);
		height: auto;
		border-radius: 0.5rem;
		box-shadow:
			0 0 2.5rem rgba(180, 190, 255, 0.18),
			0 1rem 2.5rem rgba(0, 0, 0, 0.6);
		flex-shrink: 0;
	}

	h1 {
		font-size: clamp(1.9rem, 6vw, 3.25rem);
		margin: 0 0 0.35rem;
		letter-spacing: 0.02em;
		line-height: 1.1;
	}

	h1 .amp {
		color: var(--muted);
		font-style: italic;
	}

	.tagline {
		color: var(--muted);
		margin: 0;
	}

	.tracklist {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(232, 232, 240, 0.12);
	}

	.tracklist li {
		border-bottom: 1px solid rgba(232, 232, 240, 0.12);
	}

	.tracklist a {
		display: flex;
		align-items: baseline;
		gap: 1.25rem;
		padding: 0.9rem 0.25rem;
		text-decoration: none;
		color: var(--fg);
		transition: color 0.15s ease;
	}

	.tracklist a:hover {
		color: var(--accent);
	}

	.num {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		width: 1.5rem;
	}

	.title {
		font-size: 1.05rem;
	}

	@media (max-width: 30rem) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
			text-align: left;
		}
	}
</style>
